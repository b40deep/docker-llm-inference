# Copy to .env and replace the example password before running the application.
APP_PASSWORD=replace-with-a-strong-shared-password

# Optional upstream configuration. Leave LLM_ENDPOINT_URL blank to use the safe local demo response.
# The endpoint and key are read only by the server and never returned to the browser.
# Use azure_openai for the Azure OpenAI deployment endpoint. LLM_ENDPOINT_URL must be
# the full deployment chat-completions URL, including its api-version query parameter.
# Use azure_openai_v1 for an Azure OpenAI or Foundry OpenAI v1 base URL ending in
# /openai/v1; the application appends /chat/completions and sends LLM_MODEL.
LLM_PROVIDER=openai_compatible
LLM_ENDPOINT_URL=
LLM_API_KEY=
LLM_MODEL=demo-model

# Optional application configuration
SESSION_TTL_SECONDS=28800
REQUEST_TIMEOUT_SECONDS=30
